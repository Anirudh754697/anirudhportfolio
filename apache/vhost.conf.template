# Anirudh Guthula — portfolio vhost (generated by install.sh)
<VirtualHost *:80>
    ServerName __SERVER_NAME__
    DocumentRoot __SITE_DIR__

    <Directory __SITE_DIR__>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <DirectoryMatch "^/__SITE_DIR__/api">
        <IfModule mod_php.c>
            php_flag display_errors Off
        </IfModule>
    </DirectoryMatch>

    ErrorLog ${APACHE_LOG_DIR}/anirudh-portfolio-error.log
    CustomLog ${APACHE_LOG_DIR}/anirudh-portfolio-access.log combined
</VirtualHost>
